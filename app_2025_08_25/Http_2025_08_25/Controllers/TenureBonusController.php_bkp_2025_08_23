    public function markAsPaid(Request $request, WorkerTenureBonus $bonus)
    {
        $bonus->update([
            'is_paid' => true,
            'paid_date' => now(),
            'payment_reference' => $request->payment_reference,
        ]);

        return redirect()->back()
            ->with('success', 'Bonus marked as paid successfully!');
    }

    public function markAsPaidBulk(Request $request)
    {
        $request->validate([
            'keys' => 'required|array',
            'keys.*' => 'exists:worker_tenure_bonuses,id'
        ]);

        $bonusIds = $request->keys;
        $updatedCount = 0;

        foreach ($bonusIds as $bonusId) {
            $bonus = WorkerTenureBonus::find($bonusId);
            if ($bonus && !$bonus->is_paid) {
                $bonus->update([
                    'is_paid' => true,
                    'paid_date' => now(),
                    'payment_reference' => 'Bulk Payment - ' . now()->format('Y-m-d H:i:s'),
                ]);
                $updatedCount++;
            }
        }

        return response()->json([
            'message' => "Successfully marked {$updatedCount} bonuses as paid!",
            'updated_count' => $updatedCount
        ]);
    }

    public function markUnpaid(Request $request, WorkerTenureBonus $bonus)
    {
        $request->validate([
            'unpaid_reason' => 'required|string|max:255',
            'unpaid_notes' => 'nullable|string|max:1000',
        ]);

        $bonus->update([
            'is_paid' => false,
            'is_unpaid' => true,
            'unpaid_reason' => $request->unpaid_reason,
            'unpaid_notes' => $request->unpaid_notes,
            'unpaid_date' => now(),
            'paid_date' => null,
            'payment_reference' => null,
        ]);

        return redirect()->back()
            ->with('success', 'Bonus marked as unpaid successfully!');
    }

