                    "buttons": [{
                        extend: 'excel',
                        text: '<i class="fa-solid fa-file-excel"></i> Excel',
                        className: 'btn-sm border border-primary border-end-0',
                        exportOptions: {
                            columns: ':visible'
                        }
                    }],
                    "deferRender": true,
                    "processing": true,
                    "serverSide": true,
                    "ajax": "{{ route('workers.index') }}",
                    "columns": columns,
                    "oLanguage": {
                        "sSearch": ""
                    },
                    "order": [
                        [2, 'asc']
                    ],
                    "scrollX": true,
                    "scrollY": "60vh",
                    "scrollCollapse": true,
                    "fixedColumns": {
                        left: 3,
                        right: 1
                    },
                    "columnDefs": [{
                            "className": 'py-1 text-center',
                            "targets": [0]
                        },
                        {
                            "className": 'py-1 border-end border-secondary td-border-left text-center',
                            "targets": [2]
                        },
                        {
                            "className": 'py-1 border-start border-secondary td-border-left text-center',
                            "targets": [-1]
                        },
                        {
                            "className": 'py-1 text-center',
                            "targets": '_all'
                        },
                    ],
                    "lengthMenu": [
